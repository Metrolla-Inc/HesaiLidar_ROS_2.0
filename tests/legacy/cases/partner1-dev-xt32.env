# balena-fleets partner1-dev/docker-compose-ros2.yml met_lidar_driver (line 190 ff., commit 1577610)
# with partner1-dev/.env: SENSOR_MODEL=PandarXT-32, SENSOR_IP=192.168.1.201, SENSOR_PORT=2368,
# SENSOR_HOST_IP=192.168.1.100, SENSOR_POINTS_TOPIC=/lidar_points, SENSOR_FRAME_ID=hesai_lidar.
FASTRTPS_DEFAULT_PROFILES_FILE=/etc/metrolla/fastdds.xml
ROS_LOCALHOST_ONLY=1
USE_MACADDRESS_NS=0
ROS_LOG_DIR=/var/log/ros2
LIDAR_MODEL=PandarXT-32
SENSOR_IP=192.168.1.201
SENSOR_PORT=2368
HOST_IP=192.168.1.100
POINT_CLOUD_TOPIC=/lidar_points
FRAME_ID=hesai_lidar
OVERWRITE_CONFIG=true
argv: ros2 launch hesai_ros_driver start.py
