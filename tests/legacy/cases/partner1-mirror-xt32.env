# balena-fleets partner1-mirror/docker-compose-ros2.yml (and partner1-mirror2) met_lidar_driver:
# no OVERWRITE_CONFIG, no command (the image's CMD). SENSOR_MODEL/SENSOR_IP come from per-fleet
# variables that are not tracked; the XT32 values of the fleet template are used here.
FASTRTPS_DEFAULT_PROFILES_FILE=/etc/metrolla/fastdds.xml
LIDAR_MODEL=PandarXT-32
SENSOR_IP=192.168.1.201
HOST_IP=192.168.1.100
ROS_LOCALHOST_ONLY=1
USE_MACADDRESS_NS=0
